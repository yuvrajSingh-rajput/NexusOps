#!/bin/sh
# ----------------------------------------------------------------------------
# Maven Wrapper for Unix (NexusOps)
# ----------------------------------------------------------------------------
DIR="$(cd "$(dirname "$0")" && pwd)"
WRAPPER_JAR="$DIR/.mvn/wrapper/maven-wrapper.jar"

if [ ! -f "$WRAPPER_JAR" ]; then
    echo "Maven wrapper jar not found, bootstrapping..."
    curl -sLo "$WRAPPER_JAR" https://repo.maven.apache.org/maven2/org/apache/maven/wrapper/maven-wrapper/3.3.2/maven-wrapper-3.3.2.jar
fi

exec java -classpath "$WRAPPER_JAR" "-Dmaven.multiModuleProjectDirectory=$DIR" org.apache.maven.wrapper.MavenWrapperMain "$@"
