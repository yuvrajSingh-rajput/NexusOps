# ==============================================================================
# NexusOps Environment Configuration (.env.example)
# Copy this file to .env for local development. Never commit .env to source control.
# ==============================================================================

# ------------------------------------------------------------------------------
# PostgreSQL & pgvector Configuration
# ------------------------------------------------------------------------------
POSTGRES_DB=nexusops_db
POSTGRES_USER=nexusops_user
POSTGRES_PASSWORD=nexusops_secure_password
POSTGRES_PORT=5432
POSTGRES_HOST=localhost

# ------------------------------------------------------------------------------
# Redis Cache Configuration
# ------------------------------------------------------------------------------
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# ------------------------------------------------------------------------------
# Apache Kafka (KRaft mode) Configuration
# ------------------------------------------------------------------------------
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_GROUP_ID=nexusops-consumer-group

# ------------------------------------------------------------------------------
# MinIO Object Storage (S3-compatible) Configuration
# ------------------------------------------------------------------------------
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=miniopassword
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
MINIO_BUCKET_NAME=nexusops-documents
MINIO_ENDPOINT=http://localhost:9000

# ------------------------------------------------------------------------------
# Mailpit (Local SMTP and Web UI)
# ------------------------------------------------------------------------------
MAILPIT_SMTP_PORT=1025
MAILPIT_UI_PORT=8025
SPRING_MAIL_HOST=localhost
SPRING_MAIL_PORT=1025

# ------------------------------------------------------------------------------
# Security & JWT Configuration
# ------------------------------------------------------------------------------
JWT_SECRET=404E635266556A586E3272357538782F413F4428472B4B6250645367566B5970
JWT_ACCESS_TOKEN_EXPIRATION_MS=900000       # 15 minutes
JWT_REFRESH_TOKEN_EXPIRATION_MS=604800000    # 7 days

# ------------------------------------------------------------------------------
# Spring AI & LLM Provider Configuration
# Supported providers: ollama, openai, none (degrades gracefully)
# ------------------------------------------------------------------------------
SPRING_AI_PROVIDER=none
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_CHAT_MODEL=llama3.2
OLLAMA_EMBEDDING_MODEL=nomic-embed-text
OPENAI_API_KEY=

# ------------------------------------------------------------------------------
# Application Ports & Profiles
# ------------------------------------------------------------------------------
SERVER_PORT=8080
VITE_PORT=5173
SPRING_PROFILES_ACTIVE=local
